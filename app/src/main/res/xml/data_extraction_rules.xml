<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: kopia w chmurze (Auto Backup) i transfer między urządzeniami. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="trainings.db-wal" />
        <exclude domain="database" path="trainings.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="trainings.db-wal" />
        <exclude domain="database" path="trainings.db-shm" />
    </device-transfer>
</data-extraction-rules>
